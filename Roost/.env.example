GMAIL_AGENT_CLIENT_ID=
GMAIL_AGENT_CLIENT_SECRET=
GMAIL_AGENT_REFRESH_TOKEN=
GMAIL_AGENT_EMAIL=

GMAIL_LANDLORD_CLIENT_ID=
GMAIL_LANDLORD_CLIENT_SECRET=
GMAIL_LANDLORD_REFRESH_TOKEN=
GMAIL_LANDLORD_EMAIL=

# Prisma — schema lives in packages/orchestrator/prisma/schema.prisma.
# Supabase Postgres: pooled connection (transaction pooler, port 6543) for
# the app at runtime — the ?pgbouncer=true flag is required, or Prisma
# throws "prepared statement already exists" under PgBouncer's transaction
# pooling mode. connection_limit=1 is also required — without it, Prisma's
# multiple concurrent connections through the pooler can still race and
# occasionally throw "prepared statement does not exist" even with
# pgbouncer=true, especially under Next.js's parallel RSC requests. For
# DIRECT_URL (migrations only): try the true direct connection
# (db.<ref>.supabase.co:5432) first; if your network can't reach it
# (IPv6-only on newer projects), use the session pooler instead (same
# pooler host as DATABASE_URL, port 5432 — Supabase's own IPv4-compatible
# alternative for exactly this case). URL-encode special characters in the
# password (e.g. "@" -> "%40").
DATABASE_URL="postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# Supabase Auth (Google + email/password). GOOGLE_CLIENT_ID/SECRET are
# configured in the Supabase dashboard (Authentication -> Providers ->
# Google), not read by the app directly — kept here as a record only.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=               # comma-separated emails that get the ADMIN role

# No LLM API key needed — intent classification and concession sizing run on
# two small local ML models (see packages/orchestrator/src/ml/), by explicit
# choice, diverging from BUILD_SPEC.md's original Claude-API framing. See
# docs/ml-negotiation-model.md.
